{
  "name": "markdown-rs",
  "description": "The only Markdown editor you need.",
  "version": "1.49.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tauri build --no-bundle",
    "check": "svelte-kit sync && bun run check:types && bun run check:frontend && bun run check:backend",
    "bench": "vitest bench",
    "coverage": "vitest run --coverage",
    "check:backend": "echo \"Checking Backend...\" && cd src-tauri && cargo check && cargo clippy --all-targets --all-features -- -D warnings",
    "check:frontend": "echo \"Checking Frontend Syntax...\" && bunx biome check .",
    "check:types": "echo \"Checking Frontend Types...\" && svelte-check --tsconfig ./tsconfig.json",
    "clean": "rm -rf .context .svelte-kit node_modules bun.lock src-tauri/gen src-tauri/target src-tauri/Cargo.lock .pkg/src .pkg/pkg .pkg/*.zst .pkg/*.gz",
    "crates": "cd src-tauri && cargo upgrade --verbose",
    "dev": "tauri dev",
    "format": "bunx biome format --write . && cd src-tauri && cargo fmt",
    "format:check": "bunx biome format . && cd src-tauri && cargo fmt -- --check",
    "gen-icons": "tauri icon src-tauri/icons/icon.png",
    "package": "bun run build && mkdir -p .pkg && cp PKGBUILD .pkg/ && cd .pkg && makepkg -si --noconfirm --force",
    "preview": "vite preview",
    "release": "bun scripts/version.js --git",
    "repo:back": "repomix -c .repomix/repomix.src.back.json",
    "repo:front": "repomix -c .repomix/repomix.src.front.json",
    "repo:full": "repomix -c .repomix/repomix.full.json",
    "repo:skel": "repomix -c .repomix/repomix.skel.json",
    "repo:src": "repomix -c .repomix/repomix.src.json",
    "repo:tool": "repomix -c .repomix/repomix.tool.json",
    "tauri": "tauri",
    "test": "echo \"Running Tests...\" && vitest run && cd src-tauri && cargo test",
    "test:watch": "vitest",
    "ui:build": "bunx --bun vite build",
    "ui:dev": "bunx --bun vite dev",
    "update": "bun update --latest && bun run crates",
    "version": "bun scripts/version.js"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.8",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-log": "^2.9.0",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "dompurify": "^3.4.13",
    "highlight.js": "^11.11.1",
    "katex": "^0.18.1",
    "lucide-svelte": "^1.0.1",
    "mermaid": "^11.16.1",
    "modern-screenshot": "^4.7.0",
    "svelte-i18n": "^4.0.1",
    "text-case": "^1.2.11"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^30.0.1",
    "lefthook": "^2.1.10",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.5",
    "typescript": "6.0.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "typescript": "6.0.3"
  }
}
