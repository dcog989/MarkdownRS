{
  "name": "markdownrs",
  "description": "The only Markdown editor you need.",
  "version": "1.67.0",
  "private": true,
  "type": "module",
  "scripts": {
    "bench": "vitest bench",
    "build": "tauri build --no-bundle",
    "check": "svelte-kit sync && bun run check:types && bun run check:frontend && bun run check:backend",
    "check:backend": "cd src-tauri && cargo fmt --check && cargo clippy --all-targets --all-features -- -D warnings",
    "check:frontend": "bunx biome check .",
    "check:types": "svelte-check --tsconfig ./tsconfig.json --config ./vite.config.ts --tsgo",
    "clean": "rm -rf .svelte-kit build node_modules src-tauri/gen src-tauri/target website/dist coverage .pkg/src .pkg/pkg .pkg/*.zst .pkg/*.gz \"$HOME/.local/share/com.markdownrs.editor/WebKitCache\"",
    "coverage": "vitest run --coverage",
    "crates": "cd src-tauri && cargo upgrade --verbose",
    "dev": "tauri dev",
    "fix": "bun run fix:frontend && bun run fix:backend && bun run check",
    "fix:backend": "cd src-tauri && cargo clippy --fix --allow-dirty --all-targets --all-features && cargo fmt",
    "fix:frontend": "bunx biome check --write .",
    "gen-icons": "tauri icon src-tauri/icons/icon.png",
    "pack": "mkdir -p .pkg && cp PKGBUILD .pkg/ && cd .pkg && makepkg -f --noconfirm",
    "package": "bun run build && bun run pack && bun run pkg-install",
    "pkg-install": "sudo pacman -U --noconfirm \".pkg/MarkdownRS-$(sed -n 's/^pkgver=//p' PKGBUILD)-1-x86_64.pkg.tar.zst\"",
    "test": "echo \"Running Tests...\" && vitest run && cd src-tauri && cargo test",
    "update": "bun update --latest && cd src-tauri && cargo upgrade && cargo update --verbose",
    "website": "vite --config website/vite.config.js"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-clipboard-manager": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "dompurify": "^3.4.17",
    "emojilib": "^4.0.3",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.1",
    "lucide-svelte": "^1.0.1",
    "mermaid": "^12.3.0",
    "modern-screenshot": "^4.7.0",
    "svelte-i18n": "^4.0.1",
    "text-case": "^1.2.11"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^26.6.6",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "@vitest/coverage-v8": "^5.1.0",
    "jsdom": "^30.1.3",
    "lefthook": "^2.2.2",
    "marked": "^16.4.2",
    "svelte": "^5.57.3",
    "svelte-check": "4.7.8",
    "typescript": "6.0.3",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "typescript": "6.0.3"
  }
}
