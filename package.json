{
  "name": "markdown-rs",
  "description": "The only Markdown editor you need.",
  "version": "0.22.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tauri build --no-bundle",
    "build:frontend": "bunx --bun vite build",
    "check": "svelte-kit sync ; bun run lint:types ; bun run lint:frontend ; bun run lint:backend",
    "clean": "rm -rf build .context .svelte-kit node_modules bun.lock releases src-tauri/gen src-tauri/target src-tauri/Cargo.lock .pkg/src .pkg/pkg .pkg/*.pkg.tar.zst .pkg/*.gz",
    "crates": "cd src-tauri && cargo upgrade --verbose",
    "dev": "tauri dev",
    "format": "bunx biome format --write . && cd src-tauri && cargo fmt",
    "format:check": "bunx biome format . && cd src-tauri && cargo fmt -- --check",
    "gen-icons": "python3 scripts/gen-icons.py",
    "lint": "bun run lint:frontend && bun run lint:types && bun run lint:backend",
    "lint:backend": "echo \"[Lint] Checking Backend...\" && cd src-tauri && cargo check && cargo clippy --all-targets --all-features -- -D warnings",
    "lint:frontend": "echo \"[Lint] Checking Frontend Syntax...\" && bunx biome check .",
    "lint:types": "echo \"[Lint] Checking Frontend Types...\" && svelte-check --tsconfig ./tsconfig.json",
    "package": "bun run build && mkdir -p .pkg && cp PKGBUILD .pkg/ && cd .pkg && makepkg -si --noconfirm --force",
    "preview": "vite preview",
    "release": "bun scripts/version.js --git",
    "repo:back": "repomix -c .repomix/repomix.src.back.json",
    "repo:front": "repomix -c .repomix/repomix.src.front.json",
    "repo:full": "repomix -c .repomix/repomix.full.json",
    "repo:skel": "repomix -c .repomix/repomix.skel.json",
    "repo:src": "repomix -c .repomix/repomix.src.json",
    "repo:tool": "repomix -c .repomix/repomix.tool.json",
    "tauri": "tauri",
    "test": "vitest run",
    "test:watch": "vitest",
    "ui:build": "bunx --bun vite build",
    "ui:dev": "bunx --bun vite dev",
    "update": "bun update --latest && bun run crates",
    "version": "bun scripts/version.js"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/lint": "^6.9.6",
    "@codemirror/search": "^6.7.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.0",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-log": "^2.8.0",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@tauri-apps/plugin-store": "^2.4.3",
    "@tauri-apps/plugin-window-state": "^2.4.1",
    "dompurify": "^3.4.8",
    "lucide-svelte": "^1.0.1",
    "modern-screenshot": "^4.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tauri-apps/cli": "^2.11.2",
    "@testing-library/svelte": "^5.3.1",
    "@types/node": "^25.9.2",
    "autoprefixer": "^10.5.0",
    "jsdom": "^29.1.1",
    "lefthook": "^2.1.9",
    "svelte": "^5.56.2",
    "svelte-check": "^4.6.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  }
}
