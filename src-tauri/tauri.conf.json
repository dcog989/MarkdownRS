{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MarkdownRS",
  "version": "1.55.0",
  "identifier": "com.markdownrs.editor",
  "build": {
    "beforeDevCommand": "bunx --bun vite dev",
    "beforeBuildCommand": "bunx --bun vite build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../build"
  },
  "app": {
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": ["**"],
          "requireLiteralLeadingDot": false
        }
      }
    },
    "windows": [
      {
        "label": "main",
        "title": "MarkdownRS",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "visible": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/256x256.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "copyright": "",
    "category": "Productivity",
    "shortDescription": "The only Markdown editor you need.",
    "longDescription": "MarkdownRS is a fast, slim, cross-platform notepad, focused on editing Markdown documents.",
    "createUpdaterArtifacts": true,
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "fileAssociations": [
      {
        "ext": ["md", "markdown", "mdown", "mkdn", "mkd", "mdwn"],
        "name": "Markdown Document",
        "description": "Markdown Document",
        "role": "Editor",
        "mimeType": "text/markdown"
      },
      {
        "ext": ["txt"],
        "name": "Text Document",
        "description": "Text Document",
        "role": "Editor",
        "mimeType": "text/plain"
      }
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMzMDhCODYxMjhCMzc1NTgKUldSWWRiTW9ZYmdJTXpQL2lKRDgzWjN3OGFSRDZsd2sxblVYSUZtTXc5Y2szNUx0QUdYYTdRUlQK",
      "endpoints": ["https://github.com/dcog989/MarkdownRS/releases/latest/download/latest.json"]
    },
    "shell": {
      "open": true
    },
    "opener": {
      "requireLiteralLeadingDot": false
    }
  }
}
